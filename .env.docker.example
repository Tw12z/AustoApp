# Copy to .env.docker (gitignored) and fill in real values, then:
#   docker compose --env-file .env.docker up -d
DB_PASSWORD=change-me
TOKEN_SECURITY_KEY=change-me-generate-a-real-random-64-char-value
FRONTEND_URL=https://yourdomain.com
SMTP_USERNAME=
SMTP_PASSWORD=
# Set to false to temporarily close public sign-up (login/existing accounts unaffected).
ALLOW_REGISTRATION=true
