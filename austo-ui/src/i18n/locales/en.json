      "subtitle": "Streamline your operations with features built specifically for the industry.",
      "items": {
        "finance": { "title": "Live Finance Tracking", "desc": "Track gram, quarter, half, and full gold along with currency prices in real time. Follow long-term trends with daily, weekly, and monthly charts." },
        "products": { "title": "Product & Category Management", "desc": "Organize your products into categories, record purity (8k–24k) and barcode details. Update active/inactive status instantly." },
        "sales": { "title": "Quick Sale", "desc": "Make a sale in one click from the dashboard. Search by product name or barcode, add to cart, select a customer, and complete." },
        "stock": { "title": "Stock & Transfer", "desc": "Handle stock in/out with QR/barcode scanning and transfer between locations. All movements are recorded automatically." },
        "locations": { "title": "Location Management", "desc": "Categorize locations like showcase, safe, or under-safe. See at a glance which location every product is in." },
        "customers": { "title": "Customers & Suppliers", "desc": "Manage customer and supplier records. Link sales and purchase transactions to the right records for full history tracking." },
        "purchases": { "title": "Purchase Management", "desc": "Record purchases from suppliers, scrap, and raw material buys. Stock updates automatically and cost is calculated." },
        "reports": { "title": "Reports & Analytics", "desc": "View daily summaries, sales trends, stock valuation, and net profit/loss reports instantly. Cancelled sales are deducted automatically." },
        "financeModule": { "title": "Finance Module", "desc": "Enter gold and currency prices manually or follow a live price feed. Track the metrics you care about on charts." },
        "qr": { "title": "QR Code Integration", "desc": "Define a barcode for every product. Perform stock movements in seconds by scanning a QR code." },
        "secure": { "title": "Secure & Modern", "desc": "Secure access with JWT authentication, email verification, and password reset. Built on .NET 10 and React." },
        "dashboard": { "title": "Dashboard & Quick Actions", "desc": "See daily sales, purchases, net profit, and stock value on one screen. Track the sales trend on a chart and complete a quick sale instantly." }
      },
