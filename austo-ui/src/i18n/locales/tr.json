      "items": {
        "finance": { "title": "Canlı Finans Takibi", "desc": "Gram, çeyrek, yarım, tam altın ve döviz fiyatlarını anlık izleyin. Günlük, haftalık ve aylık grafiklerle uzun vadeli değişimi takip edin." },
        "products": { "title": "Ürün & Kategori Yönetimi", "desc": "Ürünlerinizi kategorilere ayırın, ayar (8k–24k) ve barkod bilgileriyle kayıt altına alın. Aktif/pasif durumu anlık güncelleyin." },
        "sales": { "title": "Hızlı Satış", "desc": "Dashboard üzerinden tek tıkla satış yapın. Ürün adı ya da barkodla arayın, sepete ekleyin, müşteri seçip tamamlayın." },
        "stock": { "title": "Stok & Transfer", "desc": "QR/barkod ile stok giriş-çıkış yapın, lokasyonlar arası transfer gerçekleştirin. Tüm hareketler otomatik kaydedilir." },
        "locations": { "title": "Lokasyon Yönetimi", "desc": "Vitrin, kasa, kasa altı gibi konumları kategorilere ayırın. Her ürünün hangi lokasyonda olduğunu anlık görün." },
        "customers": { "title": "Müşteri & Tedarikçi", "desc": "Müşteri ve tedarikçi kayıtlarını yönetin. Satış ve alış işlemlerini ilgili kayıtlara bağlayarak geçmiş takibi yapın." },
        "purchases": { "title": "Alış Yönetimi", "desc": "Tedarikçiden yapılan alışları, hurda ve ham madde alımlarını kaydedin. Stok otomatik güncellenir, maliyet hesaplanır." },
        "reports": { "title": "Raporlar & Analizler", "desc": "Günlük özet, satış trendi, stok değerleme ve net kar/zarar raporlarını anında görüntüleyin. İptal edilen satışlar otomatik düşülür." },
        "financeModule": { "title": "Finans Modülü", "desc": "Altın ve döviz fiyatlarını manuel girin ya da canlı fiyat akışını takip edin. İstediğiniz metrikleri seçerek grafiklerde izleyin." },
        "qr": { "title": "QR Kod Entegrasyonu", "desc": "Her ürün için barkod tanımlayın. Stok hareketlerini QR okutarak saniyeler içinde gerçekleştirin." },
        "secure": { "title": "Güvenli & Modern", "desc": "JWT kimlik doğrulama, e-posta doğrulama ve şifre sıfırlama ile güvenli erişim. .NET 10 ve React üzerinde inşa edilmiş." },
        "dashboard": { "title": "Dashboard & Hızlı Eylemler", "desc": "Tek ekranda günlük satış, alış, net kar ve stok değerini görün. Satış trendini grafikle takip edin, hızlı satışı anında tamamlayın." }
      }
