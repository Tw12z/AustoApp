# Copy to .env.local for local overrides, or set as a real environment
# variable in your hosting provider's build settings for production.
# Vite only exposes vars prefixed VITE_ to client code, and inlines them
# at BUILD time — changing this after `npm run build` requires a rebuild.

# Base URL of the deployed Austo26.API backend, including the /api suffix.
# Leave unset for local dev — client.ts falls back to http://localhost:5202/api
VITE_API_URL=https://api.yourdomain.com/api
